{
  "schema_version": "1.0",
  "id": "parabank.lookup_balance",
  "name": "Lookup ParaBank account balance",
  "description": "Log in, open the first account, read the available balance, stop on the account activity page.",
  "version": "1.0.0",
  "app": {
    "vendor": "parasoft",
    "product": "parabank",
    "entry_url": "https://parabank.parasoft.com/parabank/index.htm"
  },
  "params": [
    {
      "name": "username",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "ParaBank username"
    },
    {
      "name": "password",
      "type": "string",
      "secret": true,
      "required": true,
      "description": "ParaBank password (runtime only; never stored in this file)"
    }
  ],
  "outputs": [
    {
      "name": "account_id",
      "type": "string",
      "description": "First account id shown after login"
    },
    {
      "name": "available_balance",
      "type": "string",
      "description": "Available balance on the account activity page"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "type": "navigate",
      "description": "Open ParaBank",
      "risk": "safe",
      "url": "${entry_url}"
    },
    {
      "id": "s2",
      "type": "type",
      "description": "Enter username",
      "risk": "safe",
      "target": {
        "description": "username field",
        "locators": [
          { "type": "name", "value": "username" },
          { "type": "css", "value": "input[name='username']" }
        ]
      },
      "value": "${username}"
    },
    {
      "id": "s3",
      "type": "type",
      "description": "Enter password",
      "risk": "safe",
      "target": {
        "description": "password field",
        "locators": [
          { "type": "name", "value": "password" },
          { "type": "css", "value": "input[name='password']" }
        ]
      },
      "value": "${password}"
    },
    {
      "id": "s4",
      "type": "click",
      "description": "Submit login",
      "risk": "safe",
      "target": {
        "description": "Log In",
        "locators": [
          { "type": "role", "role": "button", "value": "Log In" },
          { "type": "css", "value": "input[type='submit'][value='Log In']" },
          { "type": "xpath", "value": "//input[@type='submit' and @value='Log In']" }
        ]
      }
    },
    {
      "id": "s5",
      "type": "extract",
      "description": "Read first account id from overview table",
      "risk": "safe",
      "extract": {
        "field": "account_id",
        "locators": [
          { "type": "css", "value": "#accountTable tbody tr td a" },
          { "type": "xpath", "value": "//table[@id='accountTable']//a[1]" }
        ]
      }
    },
    {
      "id": "s6",
      "type": "click",
      "description": "Open first account",
      "risk": "safe",
      "target": {
        "description": "first account link",
        "locators": [
          { "type": "css", "value": "#accountTable tbody tr td a" },
          { "type": "xpath", "value": "//table[@id='accountTable']//a[1]" }
        ]
      }
    },
    {
      "id": "s7",
      "type": "extract",
      "description": "Read available balance",
      "risk": "safe",
      "extract": {
        "field": "available_balance",
        "locators": [
          { "type": "id", "value": "availableBalance" },
          { "type": "css", "value": "#availableBalance" },
          { "type": "xpath", "value": "//td[@id='availableBalance']" }
        ]
      }
    },
    {
      "id": "s8",
      "type": "assert",
      "description": "Confirm account activity page",
      "risk": "safe",
      "assertion": {
        "url_regex": "activity\\.htm"
      }
    }
  ],
  "checkpoint": {
    "url_regex": "activity\\.htm",
    "required_outputs": ["account_id", "available_balance"]
  },
  "outcomes": [
    {
      "code": "invalid_login",
      "kind": "business_outcome",
      "text_contains": "Please enter a username and password.",
      "description": "Login form validation failed. Legitimate caller-facing result, not a crash."
    },
    {
      "code": "invalid_login",
      "kind": "business_outcome",
      "text_contains": "could not be verified",
      "description": "Credentials were rejected. Legitimate caller-facing result, not a crash."
    },
    {
      "code": "account_error",
      "kind": "business_outcome",
      "text_contains": "An internal error has occurred",
      "description": "Account activity could not be loaded for the requested id."
    },
    {
      "code": "success",
      "kind": "success",
      "url_regex": "activity\\.htm"
    }
  ]
}
