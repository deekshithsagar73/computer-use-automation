{
  "schema_version": "1.0",
  "id": "parabank.lookup_balance.hitl_demo",
  "name": "Lookup balance with HITL handoff demo",
  "description": "Same as lookup balance, but step s6 uses a stale locator so automation pauses on Accounts Overview. Operator opens the account in Chromium; replay continues on the activity page.",
  "version": "1.0.0",
  "app": {
    "vendor": "parasoft",
    "product": "parabank",
    "entry_url": "https://parabank.parasoft.com/parabank/index.htm"
  },
  "params": [
    { "name": "username", "type": "string", "secret": false, "required": true },
    { "name": "password", "type": "string", "secret": true, "required": true }
  ],
  "outputs": [
    { "name": "account_id", "type": "string" },
    { "name": "available_balance", "type": "string" }
  ],
  "steps": [
    { "id": "s1", "type": "navigate", "description": "Open ParaBank", "risk": "safe", "url": "${entry_url}" },
    {
      "id": "s2",
      "type": "type",
      "description": "Enter username",
      "risk": "safe",
      "target": {
        "locators": [
          { "type": "name", "value": "username" },
          { "type": "css", "value": "input[name='username']" }
        ]
      },
      "value": "${username}"
    },
    {
      "id": "s3",
      "type": "type",
      "description": "Enter password",
      "risk": "safe",
      "target": {
        "locators": [
          { "type": "name", "value": "password" },
          { "type": "css", "value": "input[name='password']" }
        ]
      },
      "value": "${password}"
    },
    {
      "id": "s4",
      "type": "click",
      "description": "Submit login",
      "risk": "safe",
      "target": {
        "locators": [
          { "type": "role", "role": "button", "value": "Log In" },
          { "type": "css", "value": "input[type='submit'][value='Log In']" }
        ]
      }
    },
    {
      "id": "s5",
      "type": "extract",
      "description": "Read first account id from overview",
      "risk": "safe",
      "extract": {
        "field": "account_id",
        "locators": [
          { "type": "css", "value": "#accountTable tbody tr td a" }
        ]
      }
    },
    {
      "id": "s6",
      "type": "click",
      "description": "Open first account (stale locator triggers HITL)",
      "risk": "safe",
      "target": {
        "description": "first account link",
        "locators": [
          { "type": "css", "value": "#cua-stale-account-link" }
        ]
      }
    },
    {
      "id": "s7",
      "type": "extract",
      "description": "Extract available balance",
      "risk": "safe",
      "extract": {
        "field": "available_balance",
        "locators": [
          { "type": "id", "value": "availableBalance" },
          { "type": "css", "value": "#availableBalance" }
        ]
      }
    },
    {
      "id": "s8",
      "type": "assert",
      "description": "Confirm account activity page",
      "risk": "safe",
      "assertion": { "url_regex": "activity\\.htm" }
    }
  ],
  "checkpoint": {
    "url_regex": "activity\\.htm",
    "required_outputs": ["account_id", "available_balance"]
  },
  "outcomes": [
    {
      "code": "invalid_login",
      "kind": "business_outcome",
      "text_contains": "Please enter a username and password."
    },
    {
      "code": "success",
      "kind": "success",
      "url_regex": "activity\\.htm"
    }
  ]
}
