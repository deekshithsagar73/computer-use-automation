{
  "schema_version": "1.0",
  "id": "parabank.lookup_balance.hitl_miss",
  "name": "HITL demo: locator miss after login",
  "description": "Logs into ParaBank, then intentionally misses the first-account click so the session pauses for a human. Not a production capability.",
  "version": "1.0.0",
  "app": {
    "vendor": "parasoft",
    "product": "parabank",
    "entry_url": "https://parabank.parasoft.com/parabank/index.htm"
  },
  "params": [
    {
      "name": "username",
      "type": "string",
      "secret": false,
      "required": true
    },
    {
      "name": "password",
      "type": "string",
      "secret": true,
      "required": true
    }
  ],
  "outputs": [
    { "name": "account_id", "type": "string" },
    { "name": "available_balance", "type": "string" }
  ],
  "steps": [
    {
      "id": "s1",
      "type": "navigate",
      "description": "Open ParaBank",
      "risk": "safe",
      "url": "${entry_url}"
    },
    {
      "id": "s2",
      "type": "type",
      "description": "Enter username",
      "risk": "safe",
      "target": {
        "description": "username field",
        "locators": [
          { "type": "name", "value": "username" },
          { "type": "css", "value": "input[name='username']" }
        ]
      },
      "value": "${username}"
    },
    {
      "id": "s3",
      "type": "type",
      "description": "Enter password",
      "risk": "safe",
      "target": {
        "description": "password field",
        "locators": [
          { "type": "name", "value": "password" },
          { "type": "css", "value": "input[name='password']" }
        ]
      },
      "value": "${password}"
    },
    {
      "id": "s4",
      "type": "click",
      "description": "Submit login",
      "risk": "safe",
      "target": {
        "description": "Log In",
        "locators": [
          { "type": "role", "role": "button", "value": "Log In" },
          { "type": "css", "value": "input[type='submit'][value='Log In']" }
        ]
      }
    },
    {
      "id": "s5",
      "type": "extract",
      "description": "Read first account id from overview table",
      "risk": "safe",
      "extract": {
        "field": "account_id",
        "locators": [
          { "type": "css", "value": "#accountTable tbody tr td a" }
        ]
      }
    },
    {
      "id": "s6",
      "type": "click",
      "description": "Intentionally missing locator so HITL pause fires on the overview page",
      "risk": "safe",
      "target": {
        "description": "broken first-account locator",
        "locators": [
          { "type": "css", "value": "#cua-hitl-missing-account-link" },
          { "type": "id", "value": "cua-hitl-missing-account-link" }
        ]
      }
    }
  ],
  "checkpoint": {
    "url_regex": "activity\\.htm",
    "required_outputs": ["account_id", "available_balance"]
  },
  "outcomes": [
    {
      "code": "invalid_login",
      "kind": "business_outcome",
      "text_contains": "Please enter a username and password."
    },
    {
      "code": "success",
      "kind": "success",
      "url_regex": "activity\\.htm"
    }
  ]
}
