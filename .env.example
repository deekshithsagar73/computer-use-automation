# Discovery only. Replay never calls a model.
# Default provider is OpenAI. Replay does not need a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# Optional fallback: LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TARGET_URL=https://parabank.parasoft.com/parabank/index.htm
ALLOWED_HOSTS=parabank.parasoft.com

# Demo credentials are public (Parasoft ParaBank). Do not use real PII.
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo
